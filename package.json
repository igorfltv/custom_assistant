{
  "name": "forma-platform",
  "private": true,
  "workspaces": [
    "packages/ui",
    "landing",
    "workspace",
    "admin"
  ],
  "scripts": {
    "build": "npm run build --workspace @forma/landing && npm run build --workspace @forma/workspace && npm run build --workspace @forma/admin",
    "format": "prettier --write \"{packages,landing,workspace,admin}/**/*.{ts,tsx,css,json,html}\"",
    "test:browser": "playwright test --config qa/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "prettier": "3.10.1"
  }
}
